generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ApartmentStatus {
  vacant
  occupied
  maintenance
  unavailable
}

enum LeaseStatus {
  draft
  active
  expired
  terminated
}

enum VendorServiceType {
  plumbing
  electrical
  cleaning
  landscaping
  hvac
  general_maintenance
  other
}

model Organization {
  id               String        @id @default(cuid())
  name             String
  status           OrgStatus     @default(PENDING)
  stripeCustomerId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  subscription     Subscription?
  payments         Payment[]
  events           Event[]
  buildings        Building[]
}

model Subscription {
  id                   String       @id @default(cuid())
  orgId                String       @unique
  stripeSubscriptionId String?      @unique
  stripeCustomerId     String?
  status               String
  priceId              String?
  planKey              String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  org                  Organization @relation(fields: [orgId], references: [id])
}

model Payment {
  id              String        @id @default(cuid())
  orgId           String
  stripeInvoiceId String?       @unique
  stripeSessionId String?
  amount          Decimal       @db.Decimal(12, 2)
  currency        String
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  rawPayload      Json
  createdAt       DateTime      @default(now())
  org             Organization  @relation(fields: [orgId], references: [id])
}

model Event {
  id         String       @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id])
}

model Building {
  id          String               @id @default(cuid())
  orgId       String
  name        String
  address     String?
  code        String?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments BuildingAssignment[]
  floors      Floor[]
  apartments  Apartment[]

  @@index([orgId])
}

model BuildingAssignment {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  buildingId String
  createdAt  DateTime @default(now())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([userId, buildingId])
  @@index([orgId])
  @@index([userId])
}

model Floor {
  id         String      @id @default(cuid())
  orgId      String
  buildingId String
  name       String
  order      Int
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  building   Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartments Apartment[]

  @@unique([buildingId, name])
  @@index([buildingId])
  @@index([orgId])
}

model Apartment {
  id         String          @id @default(cuid())
  orgId      String
  buildingId String
  floorId    String
  unitNumber String
  bedrooms   Int
  bathrooms  Decimal         @db.Decimal(3, 1)
  sqft       Int?
  status     ApartmentStatus @default(vacant)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor      Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  leases     Lease[]

  @@unique([buildingId, unitNumber])
  @@index([floorId])
  @@index([buildingId])
  @@index([orgId])
}

model Renter {
  id                    String   @id @default(cuid())
  orgId                 String
  fullName              String
  email                 String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  leases                Lease[]

  @@index([orgId])
}

model Lease {
  id            String      @id @default(cuid())
  orgId         String
  buildingId    String
  floorId       String
  apartmentId   String
  renterId      String
  startDate     DateTime
  endDate       DateTime
  rentAmount    Decimal     @db.Decimal(12, 2)
  depositAmount Decimal     @db.Decimal(12, 2)
  status        LeaseStatus @default(draft)
  renewalTerms  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  apartment     Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  renter        Renter      @relation(fields: [renterId], references: [id], onDelete: Restrict)

  @@index([apartmentId])
  @@index([renterId])
  @@index([buildingId])
  @@index([orgId])
}

model Vendor {
  id              String              @id @default(cuid())
  orgId           String
  companyName     String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  servicesOffered VendorServiceType[]
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orgId])
}
