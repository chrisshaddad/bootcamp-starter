generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "private"]
}

enum AccountType {
  DEVELOPER
  HIRING
  SUPER_ADMIN

  @@schema("public")
}

enum AnalyticsEventType {
  PORTFOLIO_VIEW
  PROJECT_VIEW

  @@schema("public")
}

enum CandidateStatus {
  SAVED
  CONTACTED
  REJECTED
  ACCEPTED

  @@schema("public")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("public")
}

enum AdminAuditAction {
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  PROJECT_ARCHIVED
  PROJECT_SUSPENDED
  PROJECT_RESTORED

  @@schema("public")
}

enum AdminAuditTargetType {
  USER
  PROJECT

  @@schema("public")
}

enum OrganizationType {
  COMPANY
  AGENCY
  INDIVIDUAL
  FREELANCE_CLIENT

  @@schema("public")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED

  @@schema("public")
}

enum ProjectRoleKey {
  OWNER
  EDITOR
  CONTRIBUTOR

  @@schema("public")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  UNVERIFIED

  @@schema("public")
}

enum VerificationSource {
  GITHUB_OWNER
  GITHUB_CONTRIBUTOR
  GITHUB_COLLABORATOR
  MANUAL_INVITE

  @@schema("public")
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED

  @@schema("public")
}

enum TechnologyCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  DATABASE
  CLOUD
  DEVOPS
  TOOL
  OTHER

  @@schema("public")
}

enum ProjectTechnologySource {
  SCANNER
  MANUAL
  BOTH

  @@schema("public")
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
  ARCHITECTURE_DIAGRAM

  @@schema("public")
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE

  @@schema("public")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  accountType  AccountType
  status       AccountStatus @default(ACTIVE)
  isConfirmed  Boolean     @default(false)

  suspendedAt      DateTime?
  suspensionReason String?   @db.Text
  deactivatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  developerProfile        DeveloperProfile?
  hiringProfile           HiringProfile?
  connectedAccount        ConnectedAccount?
  notificationPreference  NotificationPreference?

  sessions   Session[]
  magicLinks MagicLink[]
  
  savedCandidates       SavedCandidate[]    @relation("RecruiterSavedCandidates")
  savedByRecruiters     SavedCandidate[]    @relation("CandidateSavedBy")

  createdProjects     Project[]           @relation("ProjectCreator")
  addedMembers        ProjectMember[]     @relation("MemberAddedBy")
  projectMemberships  ProjectMember[]     @relation("UserProjectMemberships")
  sentProjectInvitations     ProjectInvitation[] @relation("ProjectInvitationsSent")
  receivedProjectInvitations ProjectInvitation[] @relation("ProjectInvitationsReceived")
  uploadedMedia       ProjectMedia[]
  savedProjects       SavedProject[]
  addedTechnologies   ProjectTechnology[] @relation("ProjectTechAddedBy")
  adminAuditLogs      AdminAuditLog[]     @relation("AdminAuditActor")
  moderatedProjects   Project[]           @relation("ProjectModerator")
  analyticsVisits     AnalyticsVisit[]    @relation("AnalyticsDeveloper")

  @@index([accountType])
  @@index([status])
  @@schema("public")
}

model DeveloperProfile {
  id String @id @default(uuid())
  userId String @unique

  publicSlug  String  @unique
  displayName String
  headline    String?
  bio         String? @db.Text
  location    String?

  profilePictureUrl  String?
  profilePictureOriginalUrl String?
  profilePictureCropZoom    Float?
  profilePictureCropX       Float?
  profilePictureCropY       Float?
  linkedinUrl        String?
  personalWebsiteUrl String?

  githubUserId      BigInt?   @unique
  githubUsername    String?   @unique
  githubConnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique

  projectInvitationEmails Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model ConnectedAccount {
  id                  String    @id @default(uuid())
  userId              String    @unique
  githubAccessToken   String?
  oauthState          String?
  oauthStateExpiresAt DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("private")
}

model HiringProfile {
  id     String @id @default(uuid())
  userId String @unique

  organizationName String
  organizationType OrganizationType
  jobTitle         String?

  linkedinUrl            String?
  organizationWebsiteUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationName])
  @@index([organizationType])
  @@schema("public")
}

model Repository {
  id String @id @default(uuid())

  githubRepoId      BigInt  @unique
  fullName          String  @unique
  ownerLogin        String
  ownerGithubUserId BigInt?
  ownerType         String?
  repoName          String
  htmlUrl           String  @unique
  isFork            Boolean @default(false)

  defaultBranch String?
  visibility    RepositoryVisibility @default(PUBLIC)

  lastPushedAt DateTime?
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?

  @@index([ownerLogin])
  @@index([repoName])
  @@schema("public")
}

model Project {
  id String @id @default(uuid())

  repositoryId    String @unique
  createdByUserId String

  title String
  slug  String @unique
  logoUrl          String?
  shortDescription String? @db.Text
  fullDescription  String? @db.Text

  deploymentUrl String?

  status ProjectStatus @default(DRAFT)

  githubOwnershipVerifiedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  moderatedAt       DateTime?
  moderationReason  String?   @db.Text
  moderatedByUserId String?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  moderatedBy User?      @relation("ProjectModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)

  members      ProjectMember[]
  invitations  ProjectInvitation[]
  technologies ProjectTechnology[]
  media        ProjectMedia[]
  savedByUsers SavedProject[]
  analyticsVisits AnalyticsVisit[]

  @@index([status])
  @@index([createdByUserId])
  @@index([moderatedByUserId])
  @@schema("public")
}

model AdminAuditLog {
  id String @id @default(uuid())

  actorUserId String?
  action      AdminAuditAction
  targetType  AdminAuditTargetType
  targetId    String
  reason      String?              @db.Text
  metadata    Json?

  createdAt DateTime @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@schema("public")
}

model AnalyticsVisit {
  id String @id @default(uuid())

  eventType       AnalyticsEventType
  targetKey       String
  developerUserId String
  projectId       String?

  visitorHash        String
  visitorAccountType AccountType?
  referrerDomain     String?
  dedupeKey          String       @unique

  occurredAt DateTime @default(now())

  developer User     @relation("AnalyticsDeveloper", fields: [developerUserId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([developerUserId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([visitorAccountType, occurredAt])
  @@index([visitorHash])
  @@schema("public")
}

model ProjectMember {
  id String @id @default(uuid())

  projectId      String
  userId         String?
  githubUserId   BigInt?
  githubUsername String?

  role ProjectRoleKey

  contributionRoleLabel String?
  contributionSummary   String? @db.Text
  githubPermission      String?
  githubRoleName        String?

  verificationStatus VerificationStatus  @default(PENDING)
  verificationSource VerificationSource?
  verifiedAt         DateTime?

  addedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: SetNull)
  addedBy User?   @relation("MemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@unique([projectId, githubUserId])
  @@index([projectId])
  @@index([userId])
  @@index([githubUsername])
  @@index([githubUserId])
  @@index([verificationStatus])
  @@index([addedByUserId])
  @@schema("public")
}

model ProjectInvitation {
  id String @id @default(uuid())

  projectId       String
  invitedByUserId String?
  inviteeUserId   String?

  inviteeGithubUserId   BigInt
  inviteeGithubUsername String

  requestedRole ProjectRoleKey

  contributionRoleLabel String?
  githubPermission      String?
  githubRoleName        String?

  status     ProjectInvitationStatus @default(PENDING)
  pendingKey String?                 @unique

  expiresAt   DateTime
  respondedAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("ProjectInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitee   User?   @relation("ProjectInvitationsReceived", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([inviteeUserId, status, createdAt])
  @@index([inviteeGithubUserId, status])
  @@index([status, expiresAt])
  @@index([invitedByUserId])
  @@schema("public")
}

model Technology {
  id       String             @id @default(uuid())
  name     String
  slug     String             @unique
  category TechnologyCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectTechnology[]

  @@index([category])
  @@schema("public")
}

model ProjectTechnology {
  id String @id @default(uuid())

  projectId    String
  technologyId String

  source ProjectTechnologySource

  evidence   String?   @db.Text
  detectedAt DateTime?

  addedByUserId String?
  isPrimary     Boolean @default(false)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  addedBy    User?      @relation("ProjectTechAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, technologyId])
  @@index([projectId])
  @@index([technologyId])
  @@index([isPrimary])
  @@index([addedByUserId])
  @@schema("public")
}

model ProjectMedia {
  id String @id @default(uuid())

  projectId        String
  uploadedByUserId String

  mediaType MediaType

  storageKey String
  publicUrl  String

  caption   String? @db.Text
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([uploadedByUserId])
  @@schema("public")
}

model SavedProject {
  id String @id @default(uuid())

  savedByUserId String
  projectId     String

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  savedBy User    @relation(fields: [savedByUserId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([savedByUserId, projectId])
  @@index([savedByUserId])
  @@index([projectId])
  @@schema("public")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("private")
}

model MagicLink {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@schema("private")
}

model SavedCandidate {
  id String @id @default(uuid())

  savedByUserId String
  candidateId   String

  status CandidateStatus @default(SAVED)
  note   String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedBy   User @relation("RecruiterSavedCandidates", fields: [savedByUserId], references: [id], onDelete: Cascade)
  candidate User @relation("CandidateSavedBy", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([savedByUserId, candidateId])
  @@index([savedByUserId])
  @@index([candidateId])
  @@index([status])
  @@schema("public")
}
